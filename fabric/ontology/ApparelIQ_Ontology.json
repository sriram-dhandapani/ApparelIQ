{
  "$comment": "Fabric IQ ontology spec for UC1 (SYNTHETIC data). Built into the Ontology item definition by `python scripts/setup_fabric.py ontology`. Tables are lh_medallion '<schema>.<table>' (same gold tables as the sm_appareliq semantic model); time-series bindings are kdb_appareliq tables. Property names are PascalCase of the source columns; value types are read from the live SQL endpoint / KQL schema at deploy time. Requirements: docs/requirements.md section 6.2.",
  "name": "ApparelIQ_Ontology",
  "description": "UC1 Athletic Marketplace Inventory Rebalancing - products, locations, markets, partners, inventory positions, supply, transfer lanes, guardrails, triggers, decision ownership and the decision lifecycle (SYNTHETIC).",
  "exclude_columns": ["record_label", "_ingest_ts", "source_batch_id", "metrics_json", "payload_json", "evidence_json", "on_hand_units_raw"],
  "entities": [
    {"name": "Product", "table": "gold.dim_product", "key": ["sku_id"], "display": "style_name",
     "doc": "SKU-size (Style -> SKU color -> SKU-size hierarchy carried as StyleId / ColorCode / Size properties).",
     "timeseries": {"table": "rt_digital_event", "timestamp": "event_ts", "key": ["sku_id"],
                    "columns": ["event_type", "market_id", "channel", "qty"]}},
    {"name": "Market", "table": "gold.dim_market", "key": ["market_id"], "display": "market_name"},
    {"name": "Location", "table": "gold.dim_location", "key": ["location_id"], "display": "location_name",
     "doc": "Store, DC or e-commerce node.",
     "timeseries": {"table": "rt_inventory_movement", "timestamp": "event_ts", "key": ["location_id"],
                    "columns": ["event_type", "to_location_id", "sku_id", "signed_qty", "reference_id"]}},
    {"name": "WholesalePartner", "table": "gold.dim_partner", "key": ["partner_id"], "display": "partner_name"},
    {"name": "InventoryPosition", "table": "gold.mart_rebalancing_candidates", "key": ["sku_id", "market_id"], "display": "sku_id",
     "doc": "Current SKU-size x market position with T1/T2 risk flags, surplus/deficit and markdown exposure. Time series: raw POS lines (Rt*) and intraday signal snapshots from rt_inventory_signal (Signal*: intraday available units, weeks of cover, intent index, T1 flag).",
     "timeseries": [
       {"table": "rt_pos_transaction", "timestamp": "event_ts", "key": ["sku_id", "market_id"],
        "columns": ["event_type", "location_id", "channel", "qty", "amount_local", "currency"]},
       {"table": "rt_inventory_signal", "timestamp": "signal_ts", "timestamp_property": "SignalTs", "prefix": "Signal",
        "key": ["sku_id", "market_id"],
        "columns": ["intraday_available", "rt_units", "rt_receipts", "intraday_rate", "intraday_weeks_of_cover",
                    "intent_index_intraday", "intent_used", "t1_intraday"]}]},
    {"name": "InboundPO", "table": "gold.fact_inbound_supply", "key": ["po_id", "line_no"], "display": "po_id"},
    {"name": "WholesaleCommitment", "table": "gold.fact_wholesale_commitment", "key": ["order_id", "line_no"], "display": "order_id"},
    {"name": "TransferLane", "table": "silver.transfer_lane", "key": ["from_location_id", "to_location_id"], "display": "mode"},
    {"name": "Guardrail", "table": "silver.margin_guardrail", "key": ["market_id", "category", "lifecycle"], "display": "lifecycle"},
    {"name": "RebalancingPair", "table": "gold.mart_rebalancing_pairs", "key": ["sku_id", "source_market_id", "destination_market_id"], "display": "sku_id",
     "doc": "T3 surplus/deficit mismatch pair with proposed transfer and margin guardrail check."},
    {"name": "TriggerEvent", "table": "gold.trigger_event", "key": ["trigger_id", "entity_key"], "display": "entity_key"},
    {"name": "Person", "table": "silver.person", "key": ["person_id"], "display": "display_name"},
    {"name": "DecisionRole", "table": "silver.decision_owner", "key": ["category", "market_id", "role", "person_id"], "display": "role",
     "doc": "Decision ownership (RACI, DS-19): category x market x role x person (duplicate ACCOUNTABLE rows are kept and flagged by DQ-12) with approval limit."},
    {"name": "DecisionCase", "table": "gold.decision_case", "key": ["case_id"], "display": "summary"},
    {"name": "Recommendation", "table": "gold.decision_recommendation", "key": ["recommendation_id"], "display": "option_label"},
    {"name": "Decision", "table": "gold.decision_record", "key": ["decision_id"], "display": "decision"},
    {"name": "DecisionAction", "table": "gold.decision_action", "key": ["action_id"], "display": "action_type"},
    {"name": "Outcome", "table": "gold.decision_outcome", "key": ["outcome_id"], "display": "metric"}
  ],
  "relationships": [
    {"name": "locatedIn", "from": "Location", "to": "Market", "table": "gold.dim_location", "from_keys": ["location_id"], "to_keys": ["market_id"]},
    {"name": "servedByDC", "from": "Location", "to": "Location", "table": "gold.dim_location", "from_keys": ["location_id"], "to_keys": ["serving_dc_id"]},
    {"name": "partnerInMarket", "from": "WholesalePartner", "to": "Market", "table": "gold.dim_partner", "from_keys": ["partner_id"], "to_keys": ["market_id"]},
    {"name": "partnerShipsFrom", "from": "WholesalePartner", "to": "Location", "table": "gold.dim_partner", "from_keys": ["partner_id"], "to_keys": ["ship_from_dc_id"]},
    {"name": "stockedAt", "from": "Product", "to": "Location", "table": "gold.fact_inventory_snapshot", "from_keys": ["sku_id"], "to_keys": ["location_id"]},
    {"name": "positionOf", "from": "InventoryPosition", "to": "Product", "table": "gold.mart_rebalancing_candidates", "from_keys": ["sku_id", "market_id"], "to_keys": ["sku_id"]},
    {"name": "positionIn", "from": "InventoryPosition", "to": "Market", "table": "gold.mart_rebalancing_candidates", "from_keys": ["sku_id", "market_id"], "to_keys": ["market_id"]},
    {"name": "reserves", "from": "WholesaleCommitment", "to": "InventoryPosition", "table": "gold.fact_wholesale_commitment", "from_keys": ["order_id", "line_no"], "to_keys": ["sku_id", "market_id"]},
    {"name": "commitmentFor", "from": "WholesaleCommitment", "to": "WholesalePartner", "table": "gold.fact_wholesale_commitment", "from_keys": ["order_id", "line_no"], "to_keys": ["partner_id"]},
    {"name": "replenishes", "from": "InboundPO", "to": "Location", "table": "gold.fact_inbound_supply", "from_keys": ["po_id", "line_no"], "to_keys": ["ship_to_location_id"]},
    {"name": "poForProduct", "from": "InboundPO", "to": "Product", "table": "gold.fact_inbound_supply", "from_keys": ["po_id", "line_no"], "to_keys": ["sku_id"]},
    {"name": "laneFrom", "from": "TransferLane", "to": "Location", "table": "silver.transfer_lane", "from_keys": ["from_location_id", "to_location_id"], "to_keys": ["from_location_id"]},
    {"name": "laneTo", "from": "TransferLane", "to": "Location", "table": "silver.transfer_lane", "from_keys": ["from_location_id", "to_location_id"], "to_keys": ["to_location_id"]},
    {"name": "guardrailFor", "from": "Guardrail", "to": "Market", "table": "silver.margin_guardrail", "from_keys": ["market_id", "category", "lifecycle"], "to_keys": ["market_id"]},
    {"name": "pairSource", "from": "RebalancingPair", "to": "InventoryPosition", "table": "gold.mart_rebalancing_pairs", "from_keys": ["sku_id", "source_market_id", "destination_market_id"], "to_keys": ["sku_id", "source_market_id"]},
    {"name": "pairDestination", "from": "RebalancingPair", "to": "InventoryPosition", "table": "gold.mart_rebalancing_pairs", "from_keys": ["sku_id", "source_market_id", "destination_market_id"], "to_keys": ["sku_id", "destination_market_id"]},
    {"name": "pairUsesLane", "from": "RebalancingPair", "to": "TransferLane", "table": "gold.mart_rebalancing_pairs", "from_keys": ["sku_id", "source_market_id", "destination_market_id"], "to_keys": ["from_location_id", "to_location_id"]},
    {"name": "firedOn", "from": "TriggerEvent", "to": "InventoryPosition", "table": "gold.trigger_event", "from_keys": ["trigger_id", "entity_key"], "to_keys": ["sku_id", "market_id"]},
    {"name": "firedIn", "from": "TriggerEvent", "to": "Market", "table": "gold.trigger_event", "from_keys": ["trigger_id", "entity_key"], "to_keys": ["market_id"]},
    {"name": "personHomeMarket", "from": "Person", "to": "Market", "table": "silver.person", "from_keys": ["person_id"], "to_keys": ["home_market_id"]},
    {"name": "roleForMarket", "from": "DecisionRole", "to": "Market", "table": "silver.decision_owner", "from_keys": ["category", "market_id", "role", "person_id"], "to_keys": ["market_id"]},
    {"name": "roleHeldBy", "from": "DecisionRole", "to": "Person", "table": "silver.decision_owner", "from_keys": ["category", "market_id", "role", "person_id"], "to_keys": ["person_id"]},
    {"name": "caseAbout", "from": "DecisionCase", "to": "InventoryPosition", "table": "gold.decision_case", "from_keys": ["case_id"], "to_keys": ["sku_id", "market_id"]},
    {"name": "caseFromTrigger", "from": "DecisionCase", "to": "TriggerEvent", "table": "gold.decision_case", "from_keys": ["case_id"], "to_keys": ["trigger_id", "entity_key"]},
    {"name": "caseOwnedBy", "from": "DecisionCase", "to": "Person", "table": "gold.decision_case", "from_keys": ["case_id"], "to_keys": ["owner_person_id"]},
    {"name": "recommendedFor", "from": "Recommendation", "to": "DecisionCase", "table": "gold.decision_recommendation", "from_keys": ["recommendation_id"], "to_keys": ["case_id"]},
    {"name": "decides", "from": "Decision", "to": "DecisionCase", "table": "gold.decision_record", "from_keys": ["decision_id"], "to_keys": ["case_id"]},
    {"name": "chooses", "from": "Decision", "to": "Recommendation", "table": "gold.decision_record", "from_keys": ["decision_id"], "to_keys": ["recommendation_id"]},
    {"name": "approves", "from": "Decision", "to": "DecisionAction", "table": "gold.decision_action", "from_keys": ["decision_id"], "to_keys": ["action_id"]},
    {"name": "measuredBy", "from": "DecisionAction", "to": "Outcome", "table": "gold.decision_outcome", "from_keys": ["action_id"], "to_keys": ["outcome_id"]}
  ]
}
