		sourceColumn: t3_mismatch_pair

	column 'Record Label'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: record_label

	partition 'Rebalancing Candidates' = entity
		mode: directLake
		source
			entityName: mart_rebalancing_candidates
			schemaName: gold
			expressionSource: DL_lh_medallion
