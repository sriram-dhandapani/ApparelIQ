/// SKU-size x market rebalancing mart: cover, days to stock-out, full-price sell-through, T1/T2 flags, markdown exposure.
table 'Rebalancing Candidates'

	/// SKU-size x market rows in the rebalancing mart.
	measure 'SKU Markets' = COUNTROWS('Rebalancing Candidates')
		formatString: #,##0
		displayFolder: Rebalancing

	/// SKU-size x markets with projected stock-out (weeks of cover < T1 max and intent index >= T1 min, launch only).
	measure 'T1 Stock-out Risk SKU Markets' = CALCULATE([SKU Markets], 'Rebalancing Candidates'[T1 Stockout Risk] = TRUE())
		formatString: #,##0
		displayFolder: Rebalancing

	/// SKU-size x markets with aging inventory (weeks of cover > T2 min and low full-price sell-through).
	measure 'T2 Aging Risk SKU Markets' = CALCULATE([SKU Markets], 'Rebalancing Candidates'[T2 Aging Risk] = TRUE())
		formatString: #,##0
		displayFolder: Rebalancing

	/// Selling plus DC available units.
	measure 'Mart Available Units' = SUM('Rebalancing Candidates'[Total Available Units])
		formatString: #,##0
		displayFolder: Rebalancing

	/// Total available units / (daily rate x 7), weighted across the selection.
	measure 'Weighted Weeks of Cover' = DIVIDE([Mart Available Units], SUM('Rebalancing Candidates'[Daily Rate]) * 7)
		formatString: #,##0.00
		displayFolder: Rebalancing

	/// Units needed to reach the target weeks of cover.
	measure 'Total Deficit Units' = SUM('Rebalancing Candidates'[Deficit Units])
		formatString: #,##0
		displayFolder: Rebalancing

	/// Surplus units above target cover that are not committed to wholesale.
	measure 'Total Transferable Surplus Units' = SUM('Rebalancing Candidates'[Transferable Surplus Units])
		formatString: #,##0
		displayFolder: Rebalancing

	/// AN-02: full-price units since launch / (units since launch + on hand), launch SKU-sizes. Reconciles with KPI Snapshot AN-02.
	measure 'AN-02 Full-Price Sell-Through' = VAR t = CALCULATETABLE('Rebalancing Candidates', KEEPFILTERS('Rebalancing Candidates'[Is Launch] = TRUE())) RETURN DIVIDE(SUMX(t, 'Rebalancing Candidates'[Full Price Units Since Launch]), MAX(1, SUMX(t, 'Rebalancing Candidates'[Units Since Launch] + 'Rebalancing Candidates'[On Hand Units])))
		formatString: 0.0%
		displayFolder: KPIs

	/// AN-03: on-hand units above the aging cover threshold x full price x expected markdown depth. Reconciles with KPI Snapshot AN-03.
	measure 'AN-03 Markdown Exposure USD' = SUM('Rebalancing Candidates'[Markdown Exposure USD])
		formatString: $#,##0
		displayFolder: KPIs

	/// AN-05: share of launch SKU-size x markets with selling-location available units > 0. Reconciles with KPI Snapshot AN-05.
	measure 'AN-05 Launch Availability' = DIVIDE(CALCULATE([SKU Markets], KEEPFILTERS('Rebalancing Candidates'[Is Launch] = TRUE()), KEEPFILTERS('Rebalancing Candidates'[Selling Available Units] > 0)), CALCULATE([SKU Markets], KEEPFILTERS('Rebalancing Candidates'[Is Launch] = TRUE())))
		formatString: 0.0%
		displayFolder: KPIs

	column 'SKU ID'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: sku_id

	column 'Market ID'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: market_id

	column 'Selling Available Units'
		dataType: int64
		summarizeBy: none
		sourceColumn: selling_available_units

	column 'DC Available Units'
		dataType: int64
		summarizeBy: none
		sourceColumn: dc_available_units

	column 'On Hand Units'
		dataType: int64
		summarizeBy: none
		sourceColumn: on_hand_units

	column 'Selling On Hand Units'
		dataType: int64
		summarizeBy: none
		sourceColumn: selling_on_hand_units

	column 'Committed Wholesale Units'
		dataType: int64
		summarizeBy: none
		sourceColumn: committed_wholesale_units

	column 'In Transit Units'
		dataType: int64
		summarizeBy: none
