	column 'Daily Rate 7D'
		dataType: double
		summarizeBy: none
		sourceColumn: daily_rate_7d

	column 'Weeks Of Cover'
		dataType: double
		summarizeBy: none
		sourceColumn: weeks_of_cover

	column 'Selling Weeks Of Cover'
		dataType: double
		summarizeBy: none
		sourceColumn: selling_weeks_of_cover

	column 'Days To Stockout'
		dataType: double
		summarizeBy: none
		sourceColumn: days_to_stockout

	column 'Style ID'
		dataType: string
		summarizeBy: none
		sourceColumn: style_id

	column 'Color Code'
		dataType: string
		summarizeBy: none
		sourceColumn: color_code

	column Size
		dataType: string
		summarizeBy: none
		sourceColumn: size

	column Category
		dataType: string
		summarizeBy: none
